<Window x:Class="BaeSenX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BaeSenX｜Bishop 腳本中文化工具"
        Width="820" Height="620"
        MinWidth="720" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#FFF5F6F8">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="BaeSenX" FontSize="26" FontWeight="SemiBold" Foreground="#FF202938"/>
            <TextBlock Text="Bishop BSXScript 3.0～3.3｜文字匯出、翻譯匯入與安全重建"
                       Margin="0,4,0,0" FontSize="13" Foreground="#FF536273"/>
        </StackPanel>

        <GroupBox Grid.Row="1" Header="來源腳本" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ScriptPathTextBox" Grid.Row="0" Grid.Column="0"
                         Height="32" Padding="7,5" VerticalContentAlignment="Center"
                         IsReadOnly="True" Background="White"/>
                <Button x:Name="BrowseScriptButton" Grid.Row="0" Grid.Column="1"
                        Content="選擇 bsxx.dat" Width="132" Height="32" Margin="10,0,0,0"
                        Click="BrowseScriptButton_Click"/>
                <TextBlock x:Name="ScriptInfoTextBlock" Grid.Row="1" Grid.ColumnSpan="2"
                           Margin="2,9,0,0" Text="尚未選擇腳本。支援 BSXScript 3.0～3.3。"
                           Foreground="#FF536273" TextWrapping="Wrap"/>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="中文化作業" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <Button x:Name="ExportButton" Content="① 匯出翻譯文字檔" Height="42"
                            IsEnabled="False" Click="ExportButton_Click"/>
                    <TextBlock Text="匯出角色名稱、對話與選項文字；使用 UTF-8 編碼。"
                               Margin="2,7,2,0" Foreground="#FF536273" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <Button x:Name="ImportButton" Content="② 匯入翻譯並產生新腳本" Height="42"
                            IsEnabled="False" Click="ImportButton_Click"/>
                    <TextBlock Text="保留原始 Opcode，不覆蓋來源 bsxx.dat，另存翻譯版。"
                               Margin="2,7,2,0" Foreground="#FF536273" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="處理紀錄" Padding="10">
            <TextBox x:Name="LogTextBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     Background="#FFFCFDFE" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12"
                     Padding="6"/>
        </GroupBox>

        <DockPanel Grid.Row="4" Margin="0,12,0,0">
            <TextBlock Text="Windows 10 x64｜不需額外安裝第三方套件"
                       Foreground="#FF657386" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusTextBlock" DockPanel.Dock="Right"
                       Text="就緒" Foreground="#FF286548" FontWeight="SemiBold"
                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </DockPanel>
    </Grid>
</Window>
