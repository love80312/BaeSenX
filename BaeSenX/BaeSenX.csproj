<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Provides .NET Framework 4.8 reference assemblies to clean build agents. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <!-- Keep the unfinished Opcode research code in the repository, but do not
       compile it into this translation-first GUI release. -->
  <ItemGroup>
    <Compile Remove="BSXScript.cs" />
    <Compile Remove="DecompilerHelper.cs" />
  </ItemGroup>

</Project>
